# ── Production build (Next.js + Supabase). The prototype in dist/ruka.html needs none of these. ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key            # safe for the browser: RLS protects data
SUPABASE_SERVICE_ROLE_KEY=server-only-never-expose        # server routes / ingestion worker only
LLM_PROVIDER=openai                                       # adapter interface: openai | anthropic
OPENAI_API_KEY=server-only-never-expose
LLM_MODEL_ANSWER=                                         # set to the current recommended model
EMBEDDING_MODEL=text-embedding-3-small                    # 1536 dims, matches vector(1536)
UPSTASH_REDIS_REST_URL=                                   # rate limiting
UPSTASH_REDIS_REST_TOKEN=
ADMIN_ALLOWED_EMAILS=you@example.com                      # bootstrap admins; role lives in app_metadata
